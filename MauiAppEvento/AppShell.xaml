<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppEvento.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppEvento"
    Shell.FlyoutBehavior="Disabled"
    Title="MauiAppEvento">

    <!-- Embora App.xaml.cs defina a MainPage, é boa prática
         manter o Shell atualizado ou removê-lo se não for usado.
         Vou apenas atualizar o namespace aqui. -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

</Shell>